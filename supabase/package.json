{
  "name": "@no-stack/supabase",
  "scripts": {
    "dev": "supabase --workdir .. start",
    "clean-db": "supabase --workdir .. db reset --local",
    "supabase:deploy": "supabase --workdir .. link --project-ref \"$SUPABASE_PROJECT_REF\" && supabase --workdir .. db push",
    "supabase:migrate-local": "supabase --workdir .. db push --local",
    "update-config": "supabase --workdir .. stop && supabase --workdir .. start"
  },
  "devDependencies": {
    "supabase": "^2.121.0"
  }
}
