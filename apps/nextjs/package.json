    "react-dom": "catalog:react19",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@no-stack/eslint-config": "workspace:*",
    "@no-stack/prettier-config": "workspace:*",
    "@no-stack/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "dotenv-cli": "^11.0.0",
