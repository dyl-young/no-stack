{
  "name": "@no-stack/api",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf .turbo node_modules",
    "dev": "tsc --watch",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "prettier": "@no-stack/prettier-config",
  "dependencies": {
    "@trpc/server": "catalog:",
    "superjson": "2.2.6",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@no-stack/eslint-config": "workspace:*",
    "@no-stack/prettier-config": "workspace:*",
    "@no-stack/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "tsx": "catalog:"
  }
}
